{
  "name": "konggu-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "npm run build:sidecar && tauri build",
    "build:frontend": "vite build",
    "build:sidecar": ".venv\\Scripts\\python.exe -m PyInstaller --clean KongguWorker.spec && node scripts/rename-sidecar.mjs",
    "prepare:offline": "python tools/prepare_offline_resources.py --download-ocr",
    "prepare:offline:dev": "python tools/prepare_offline_resources.py --allow-missing-ocr"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.3"
  }
}
