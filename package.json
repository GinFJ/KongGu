{
  "name": "konggu-desktop",
  "private": true,
  "version": "0.6.5",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-candidate.ps1",
    "check:privacy": ".venv\\Scripts\\python.exe tools\\check_repo_privacy.py",
    "check:privacy:history": ".venv\\Scripts\\python.exe tools\\check_repo_privacy.py --all-history",
    "build:release:signed": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-release-signed.ps1",
    "build:frontend": "vite build",
    "build:sidecar": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-candidate.ps1 -WorkerOnly",
    "prepare:offline": "python tools/prepare_offline_resources.py --download-ocr",
    "prepare:offline:dev": "python tools/prepare_offline_resources.py --allow-missing-ocr"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.3"
  }
}
