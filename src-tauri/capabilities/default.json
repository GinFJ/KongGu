{
  "identifier": "default",
  "description": "Konggu desktop window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-file",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/konggu-worker",
          "sidecar": true,
          "args": ["--serve"]
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
