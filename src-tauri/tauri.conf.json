{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konggu",
  "version": "0.3.1",
  "identifier": "cn.konggu.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev:frontend",
    "beforeBuildCommand": "npm.cmd run build:frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Konggu",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/konggu-worker"],
    "resources": {
      "../resources/": "resources/",
      "../config/": "config/",
      "../assets/": "assets/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
