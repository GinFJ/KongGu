{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konggu",
  "version": "0.5.2",
  "identifier": "cn.konggu.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev:frontend",
    "beforeBuildCommand": "npm.cmd run build:frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "空谷 Konggu",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/konggu-worker"],
    "resources": {
      "../resources/": "resources/",
      "../config/": "config/",
      "../assets/": "assets/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
